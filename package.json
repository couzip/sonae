{
  "name": "sonae",
  "version": "0.1.0",
  "private": true,
  "description": "Sonae — Survive before it strikes. Pre-disaster preparedness grounded in your city's own published forecasts. Built for Gemma 4 Good Hackathon.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"data/**/*.{yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"data/**/*.{yaml,yml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "example:news": "tsx examples/news-summarizer/run.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.46",
    "@ai-sdk/react": "^3.0.177",
    "@hookform/resolvers": "^3.9.0",
    "@napi-rs/canvas": "^0.1.96",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "ai": "^6.0.175",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "framer-motion": "^11.11.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^4.7.1",
    "next": "^15.0.3",
    "pdfjs-dist": "^5.6.205",
    "playwright": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-map-gl": "^7.1.7",
    "react-markdown": "^10.1.0",
    "rebrowser-playwright": "^1.52.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "overrides": {
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
