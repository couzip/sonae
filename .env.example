# LLM (構造化抽出 / 次の活動方針生成)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=gemma-4-e4b-it@q4_k_s

# OCR (Vision LLM)
OCR_BASE_URL=http://localhost:1234/v1
OCR_API_KEY=not-needed
OCR_MODEL=enginil/dots.mocr

# browser-use (Discovery)
# Visible Chromium by default — Google detects headless mode and serves
# reCAPTCHA, breaking the Discovery search flow. Set 'true' only on hosts
# without a display server (where you must accept the reCAPTCHA risk).
BROWSER_USE_HEADLESS=false

# Admin panel (/admin と /api/admin)
# 未設定の場合 503 を返し、管理画面は無効化されます。
# JWT_SECRET は最低 32 文字。`openssl rand -hex 32` で生成してください。
# 認証方式を NextAuth/Auth0/SSO 等に差し替える場合は src/middleware.ts を編集します。
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
