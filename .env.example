# Main LLM (OpenAI 互換 chat/completions)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=gemma-4-e4b-it@q4_k_s

# 役割別の override (未指定なら LLM_* にフォールバック)
#   discovery:    PDF picker (1 LLM call、軽量で OK)
#   toc:          目次から被害想定章を選ぶ (1 call、章選定精度が重要)
#   step_a:       災害種別列挙 (1 call、網羅性重視)
#   next_actions: 次の活動方針生成 (1 call)
#   chat:         RAG agent (tools chain で複数呼び出し、function calling 精度重要)
# 推奨: toc / step_a / chat に大きめモデル (例: 26B) を割り当てると精度が上がる。
# DISCOVERY_LLM_BASE_URL=
# DISCOVERY_LLM_API_KEY=
# DISCOVERY_LLM_MODEL=
# TOC_LLM_BASE_URL=
# TOC_LLM_API_KEY=
# TOC_LLM_MODEL=
# STEP_A_LLM_BASE_URL=
# STEP_A_LLM_API_KEY=
# STEP_A_LLM_MODEL=
# NEXT_ACTIONS_LLM_BASE_URL=
# NEXT_ACTIONS_LLM_API_KEY=
# NEXT_ACTIONS_LLM_MODEL=
# CHAT_LLM_BASE_URL=
# CHAT_LLM_API_KEY=
# CHAT_LLM_MODEL=

# Reasoning (thinking) モード: off | low | medium | high
# OpenRouter / LiteLLM proxy 経由の reasoning 対応モデルでのみ有効。
# LM Studio はモデル側設定 (Jinja template + Reasoning Parser) が必要で、ここの値は使われません。
EXTRACT_STEP_A_REASONING_EFFORT=off
EXTRACT_STEP_B_REASONING_EFFORT=off

# OCR (Vision LLM、LLM_* にフォールバックしない)
OCR_BASE_URL=http://localhost:1234/v1
OCR_API_KEY=not-needed
OCR_MODEL=enginil/dots.mocr

# Chromium を visible で起動 (Google bot 検出回避のため推奨)。
# headless にすると Google が reCAPTCHA を返して Discovery が失敗する場合がある。
BROWSER_USE_HEADLESS=false

# Admin panel (/admin と /api/admin)
# 未設定の場合 503 を返し、管理画面は無効化されます。
# JWT_SECRET は最低 32 文字。`openssl rand -hex 32` で生成してください。
# 認証方式を NextAuth/Auth0/SSO 等に差し替える場合は src/middleware.ts を編集します。
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
